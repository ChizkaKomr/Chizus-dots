{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
       "source": "~/.config/fastfetch/logos/miku5.png",
       "type": "auto",
       "height": 17,
       "padding": {
          "top": 4,
          "left": 2,
          "right": 2
       }
    },
    "display": {
       "separator": " -> ",
       "color": {
          "separator": "cyan"
       }
    },
    "modules": [
       "break",
       {
          "type": "custom",
          "format": "{#keys}{#1}{#cyan}Hardware"
       },
       {
          "type": "cpu",
          "key": "├ CPU    ",
          "keyColor": "cyan",
          "format": "{1}",
          "temp": false
       },
       {
          "type": "gpu",
          "key": "├ GPU    ",
          "keyColor": "cyan",
          "format": "{2}",
          "temp": false
       },
       {
          "type": "memory",
          "key": "├ RAM    ",
          "keyColor": "cyan"
       },
       {
          "type": "disk",
          "key": "├ SSD    ",
          "keyColor": "cyan",
          "folders": "/",
          "format": "{1} / {2} ({3})"
       },
       {
          "type": "disk",
          "key": "└ HDD    ",
          "keyColor": "cyan",
          "folders": "/run/media/chizuko/53b184b0-ee80-4a64-9f9c-e40587c882e3",
          "format": "{1} / {2} ({3})"
       },
       "break",
       {
          "type": "custom",
          "format": "{#keys}{#1}{#cyan}Software"
       },
       {
          "type": "os",
          "key": "├ OS      ",
          "keyColor": "cyan",
          "format": "{2} {10}"
       },
       {
          "type": "wm",
          "key": "├ WM      ",
          "keyColor": "cyan"
       },
       {
          "type": "packages",
          "key": "├ Pkgs    ",
          "keyColor": "cyan"
       },
       {
          "type": "terminal",
          "key": "└ Terminal",
          "keyColor": "cyan"
       },
       "break",
       {
          "type": "custom",
          "format": "{#keys}{#1}{#cyan}Time"
       },
       {
          "type": "command",
          "key": "├ OS Age",
          "keyColor": "cyan",
          "text": "echo \"39 days\""
       },
       {
          "type": "uptime",
          "key": "└ Uptime",
          "keyColor": "cyan"
       },
       "break",
       {
          "type": "colors",
          "symbol": "block"
       },
       "break"
    ]
}
