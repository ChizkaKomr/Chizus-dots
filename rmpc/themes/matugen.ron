#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    background_color: None,
    text_color: Some("#e1c1a3"),
    header_background_color: None,
    modal_background_color: None,
    modal_backdrop: false,
    preview_label_style: (fg: "#fcb974"),
    preview_metadata_group_style: (fg: "#bfcc9b", modifiers: "Bold"),
    tab_bar: (
        active_style: (fg: "#402c18", bg: "#e1c1a3", modifiers: "Bold"),
        inactive_style: (fg: "#e1c1a3", modifiers: "Bold"),
    ),
    highlighted_item_style: (fg: "#e1c1a3", modifiers: "Bold"),
    current_item_style: (fg: "#e1c1a3", bg: "#855317", modifiers: "Bold"),
    borders_style: (fg: "#e1c1a3"),
    highlight_border_style: (fg: "#e1c1a3"),
    symbols: (
        song: "S",
        dir: "D",
        playlist: "P",
        marker: "M",
        ellipsis: "...",
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),
    level_styles: (
        info: (fg: "blue", bg: "black"),
        warn: (fg: "yellow", bg: "black"),
        error: (fg: "red", bg: "black"),
        debug: (fg: "light_green", bg: "black"),
        trace: (fg: "magenta", bg: "black"),
    ),
    progress_bar: (
        symbols: ["[", "█", "█", "░", "]"],
        track_style: (
            fg: "#402c18",
        ),
        elapsed_style: (
            fg: "#e1c1a3",
        ),
        thumb_style: (
            fg: "#e1c1a3",
        ),
        use_track_when_empty: false,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#e1c1a3"),
        ends_style: (fg: "#feddbe"),
        thumb_style: (fg: "#fcb974"),
    ),
    song_table_format: [
        (
            prop: (
                kind: Property(Artist),
                style: (fg: "#ffdcbd"),
                default: (kind: Text("Unknown"), style: (fg: "#ffdcbd"))
            ),
            width: "20%",
        ),
        (
            prop: (
                kind: Property(Title),
                style: (fg: "#fcb974"),
                default: (kind: Text("Unknown"), style: (fg: "#ffdcbd"))
            ),
            width: "35%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#ffdcbd"),
                default: (kind: Text("Unknown Album"), style: (fg: "#ffdcbd"))
            ),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "#fcb974"),
                default: (kind: Text("-"), style: (fg: "#ffdcbd"))
            ),
            width: "15%",
            alignment: Right,
        ),
    ],
    components: {},
    tabs: [
        (
            name: "Queue",
            pane: Split(
                direction: Horizontal,
                panes: [
                    (size: "40%", pane: Pane(AlbumArt)),
                    (size: "60%", pane: Split(
                        direction: Vertical,
                        panes: [
                            (size: "50%", pane: Pane(Queue)),
                            (size: "50%", pane: Pane(Cava)),
                        ],
                    )),
                ],
            ),
        ),
        (
            name: "Directories",
            pane: Pane(Directories),
        ),
        (
            name: "Artists",
            pane: Pane(Artists),
        ),
        (
            name: "Albums",
            pane: Pane(Albums),
        ),
        (
            name: "Playlists",
            pane: Pane(Playlists),
        ),
        (
            name: "Search",
            pane: Pane(Search),
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                pane: Pane(Header),
                size: "2",
            ),
            (
                pane: Pane(Tabs),
                size: "3",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                pane: Pane(ProgressBar),
                size: "1",
            ),
        ],
    ),
    header: (
        rows: [
            (
                left: [
                    (kind: Text("["), style: (fg: "#bfcc9b", modifiers: "Bold")),
                    (
                      kind: Property(Status(StateV2(playing_label: "Playing", paused_label: "Paused", stopped_label: "Stopped"))),
                      style: (fg: "#bfcc9b", modifiers: "Bold")
                    ),
                    (kind: Text("]"), style: (fg: "#bfcc9b", modifiers: "Bold"))
                ],
                center: [
                    (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                        default: (kind: Text("No Song"), style: (modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Property(Widget(ScanStatus)), style: (fg: "#fcb974")),
                    (kind: Property(Widget(Volume)), style: (fg: "#fcb974"))
                ]
            ),
            (
                left: [
                    (kind: Property(Status(Elapsed))),
                    (kind: Text(" / ")),
                    (kind: Property(Status(Duration))),
                    (kind: Text(" (")),
                    (kind: Property(Status(Bitrate))),
                    (kind: Text(" kbps)"))
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "#bfcc9b", modifiers: "Bold"),
                        default: (kind: Text("Unknown"), style: (fg: "#bfcc9b", modifiers: "Bold"))
                    ),
                    (kind: Text(" - ")),
                    (kind: Property(Song(Album)),
                        style: (fg: "#fcb974"),
                        default: (kind: Text("Unknown Album"))
                    )
                ],
                right: [
                    (
                        kind: Property(Widget(States(
                            active_style: (fg: "#fcb974", modifiers: "Bold"),
                            separator_style: (fg: "#fcb974")))
                        ),
                        style: (fg: "#e1c1a3")
                    ),
                ]
            ),
        ],
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track), style: (fg: "#fcb974")),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist), style: (fg: "#fcb974")),
                (kind: Text(" - ")),
                (kind: Property(Title), style: (fg: "#fcb974")),
            ]),
            default: (kind: Property(Filename), style: (fg: "#fcb974"))
        ),
    ],
    lyrics: (
        timestamp: false
    ),
    cava: (
        bar_width: 2,
        bar_spacing: 1,
        orientation: Bottom,
        bar_color: Gradient({
            0: "#693c00",
            50: "#fcb974",
            100: "#ffdcbd"
        })
    ),
)
